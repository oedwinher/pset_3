# ==============================================================================
# CONFIGURACIÓN DE ACCESO A SNOWFLAKE Y MLFLOW (PSet #3)
# Instrucciones: Copia este archivo como '.env' en la raíz del proyecto y completa
# con tus credenciales de Snowflake. NO subas el archivo '.env' a GitHub.
#   PowerShell: Copy-Item .env.example .env
#   Bash/Linux: cp .env.example .env
# ==============================================================================

# Identificador de cuenta con formato <locator>.<region> (ej. ab12345.us-east-1)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1

# Usuario con permisos de lectura sobre PSET2_DB.ANALYTICS y creación de tablas auxiliares
SNOWFLAKE_USER=TU_USUARIO_SNOWFLAKE

# Contraseña de la cuenta de Snowflake
SNOWFLAKE_PASSWORD=TuPasswordSeguro123!

# Rol activo (ej. ACCOUNTADMIN o SYSADMIN)
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Nombre del Virtual Warehouse activo para cómputo
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Base de datos del proyecto (creada en PSet #2)
SNOWFLAKE_DATABASE=PSET2_DB

# Esquema analítico donde vive la OBT y la tabla auxiliar de precios
SNOWFLAKE_SCHEMA=ANALYTICS

# Puerto de Kestra (legado PSet #2, opcional)
KESTRA_PORT=8080

# Servidor de tracking de MLflow (levantado con docker compose up -d)
MLFLOW_TRACKING_URI=http://localhost:5000

# Nombre del experimento en MLflow
MLFLOW_EXPERIMENT_NAME=nowcasting-f104-sri
